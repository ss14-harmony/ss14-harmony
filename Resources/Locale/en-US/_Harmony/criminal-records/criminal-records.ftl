## Additional Harmony statuses
criminal-records-status-monitor = Monitor
criminal-records-status-search = Search

criminal-records-console-monitor = {$name} was marked as monitored by {$officer} for: {$reason}.
criminal-records-console-search = {$name} was marked for search by {$officer} for: {$reason}.
criminal-records-console-not-monitor = {$officer} cleared the monitored status of {$name}.
criminal-records-console-not-search = {$officer} cleared the search status of {$name}.

## Status Sync for Crime History

## Status PR above forgot to add reasons
criminal-records-console-monitor-reason = Monitor reason
criminal-records-console-search-reason = Search reason

## if someone wants to explain WHY they cleared the status they can manually add it

criminal-records-auto-history-wanted = WANTED: {$reason}.
criminal-records-auto-history-not-wanted = Wanted status cleared.
criminal-records-auto-history-suspected = SUSPICIOUS: {$reason}
criminal-records-auto-history-not-suspected = Cleared of suspicion.
## Adding Detain for the new system
criminal-records-auto-history-detained = ARRESTED: {$reason}.
criminal-records-auto-history-released = Released.
criminal-records-auto-history-paroled = Released on parole.
criminal-records-auto-history-not-parole = Cleared of parole.
criminal-records-auto-history-hostile = HOSTILE: {$reason}.
criminal-records-auto-history-not-hostile = Hostile status cleared.
criminal-records-auto-history-eliminated = ELIMINATED.
criminal-records-auto-history-not-eliminated = Eliminated status cleared.
criminal-records-auto-history-monitor = MONITOR: {$reason}.
criminal-records-auto-history-search = SEARCH: {$reason}.
criminal-records-auto-history-not-monitor = Cleared monitored status.
criminal-records-auto-history-not-search = Cleared search status.

## Because even the console is confused on why you would ever do this, also doubt it'll be seen in round common enough for people to notice/care
criminal-records-auto-history-not-discharged = Discharged status cleared?

## Security channel notifications
criminal-records-console-not-discharged = {$name} ({$job}) has been cleared of discharged status by {$officer}?
